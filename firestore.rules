rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Funciones comunes
    // ---------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return request.auth.token.email_verified == true;
    }

    // Único rol del sistema. `status` es interno (solo se cambia desde
    // Firebase Console): un docente inactivo no puede usar sus datos.
    // Lee el perfil UNA sola vez por operación (límite de lecturas).
    function isActiveTeacher() {
      let perfil = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn() && isVerified()
          && perfil.role == 'docente'
          && perfil.status == 'activo';
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function isShortString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // Hora del día "HH:mm" (00:00 - 23:59). Con este formato la comparación
    // de textos equivale a comparar horas.
    function isHora(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // Aproximación en el servidor de "semana actual": la app aplica la regla
    // exacta (lunes a domingo); aquí se impide tocar sesiones lejanas a hoy.
    function isNearNow(fecha) {
      return fecha is timestamp
          && fecha > request.time - duration.value(8, 'd')
          && fecha < request.time + duration.value(8, 'd');
    }

    function ownsResource() {
      return resource.data.docenteId == request.auth.uid;
    }

    // El curso existe y es del docente que hace la petición.
    function isOwnCurso(cursoId) {
      return cursoId is string
          && exists(/databases/$(database)/documents/cursos/$(cursoId))
          && get(/databases/$(database)/documents/cursos/$(cursoId)).data.docenteId == request.auth.uid;
    }

    // El estudiante existe y es del docente que hace la petición.
    function isOwnEstudiante(estudianteId) {
      return estudianteId is string
          && exists(/databases/$(database)/documents/estudiantes/$(estudianteId))
          && get(/databases/$(database)/documents/estudiantes/$(estudianteId)).data.docenteId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // users: perfil del docente (único rol del sistema)
    // ---------------------------------------------------------------------
    match /users/{userId} {
      // Cada docente lee solo su propio perfil (también si está inactivo,
      // para que la app pueda mostrarle que su cuenta está deshabilitada).
      allow read: if isSignedIn() && request.auth.uid == userId;

      // Registro público: el propio usuario crea su perfil, siempre como
      // docente activo con contraseña pendiente y sin campos extra.
      allow create: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.role == 'docente'
                    && request.resource.data.status == 'activo'
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.mustChangePassword == true
                    && request.resource.data.keys().hasAll([
                         'firstName', 'lastName', 'dni', 'email',
                         'role', 'status', 'mustChangePassword', 'createdAt'
                       ])
                    && request.resource.data.keys().hasOnly([
                         'firstName', 'lastName', 'dni', 'phone', 'email', 'role',
                         'status', 'hireDate', 'mustChangePassword', 'createdAt'
                       ])
                    // Datos del formulario de registro (vacíos solo si el
                    // perfil se recrea sin ellos).
                    && request.resource.data.firstName is string
                    && request.resource.data.firstName.size() <= 80
                    && request.resource.data.lastName is string
                    && request.resource.data.lastName.size() <= 80
                    && request.resource.data.dni is string
                    && request.resource.data.dni.matches('^([0-9]{8})?$')
                    && (request.resource.data.get('phone', null) == null
                        || (request.resource.data.phone is string
                            && request.resource.data.phone.matches('^\\+51[0-9]{9}$')));

      // Verificación por SMS: el teléfono solo puede ser el número que
      // Firebase Auth confirmó y vinculó a la cuenta.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'updatedAt'])
                    && request.auth.token.phone_number != null
                    && request.resource.data.phone == request.auth.token.phone_number;

      // Al crear su contraseña, el docente solo puede apagar esta bandera.
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
                    && request.resource.data.mustChangePassword == false;

      // "Mi perfil": el docente activo edita sus datos personales. Nunca
      // puede tocar role, status, email, phone (verificado por SMS),
      // mustChangePassword ni createdAt.
      allow update: if isActiveTeacher()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'firstName', 'lastName', 'dni', 'hireDate', 'updatedAt'
                       ])
                    && request.resource.data.firstName is string
                    && request.resource.data.firstName.size() <= 80
                    && request.resource.data.lastName is string
                    && request.resource.data.lastName.size() <= 80
                    && request.resource.data.dni is string
                    && request.resource.data.dni.matches('^[0-9]{8}$')
                    && isOptionalString(request.resource.data.phone)
                    && (request.resource.data.hireDate == null
                        || request.resource.data.hireDate is timestamp);

      // Los perfiles nunca se borran desde la app.
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // cursos: se crean con sus sesiones; solo se editan los datos
    // descriptivos (el horario generó las sesiones).
    // ---------------------------------------------------------------------
    match /cursos/{cursoId} {
      allow read: if isActiveTeacher() && ownsResource();

      allow create: if isActiveTeacher()
                    && request.resource.data.docenteId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'docenteId', 'codigo', 'nombre', 'creditos', 'totalSesiones', 'diasSemana',
                         'horaInicio', 'horaFin', 'fechaInicio', 'createdAt'
                       ])
                    && request.resource.data.keys().hasOnly([
                         'docenteId', 'codigo', 'nombre', 'descripcion', 'creditos', 'totalSesiones',
                         'diasSemana', 'horaInicio', 'horaFin', 'fechaInicio', 'createdAt'
                       ])
                    && isShortString(request.resource.data.codigo, 1, 12)
                    && isShortString(request.resource.data.nombre, 1, 80)
                    && (request.resource.data.get('descripcion', null) == null
                        || isShortString(request.resource.data.descripcion, 1, 200))
                    && request.resource.data.creditos is int
                    && request.resource.data.creditos >= 1
                    && request.resource.data.creditos <= 10
                    && request.resource.data.totalSesiones is int
                    && request.resource.data.totalSesiones >= 1
                    && request.resource.data.totalSesiones <= 60
                    && request.resource.data.diasSemana is list
                    && request.resource.data.diasSemana.size() >= 1
                    && request.resource.data.diasSemana.size() <= 7
                    && request.resource.data.diasSemana.hasOnly([1, 2, 3, 4, 5, 6, 7])
                    && isHora(request.resource.data.horaInicio)
                    && isHora(request.resource.data.horaFin)
                    && request.resource.data.horaInicio < request.resource.data.horaFin
                    && request.resource.data.fechaInicio is timestamp
                    && request.resource.data.createdAt == request.time;

      allow update: if isActiveTeacher()
                    && ownsResource()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['codigo', 'nombre', 'descripcion', 'creditos', 'updatedAt'])
                    && isShortString(request.resource.data.codigo, 1, 12)
                    && isShortString(request.resource.data.nombre, 1, 80)
                    && (request.resource.data.get('descripcion', null) == null
                        || isShortString(request.resource.data.descripcion, 1, 200))
                    && request.resource.data.creditos is int
                    && request.resource.data.creditos >= 1
                    && request.resource.data.creditos <= 10
                    && request.resource.data.updatedAt == request.time;

      // Las sesiones, matrículas y evaluaciones las borra la app.
      allow delete: if isActiveTeacher() && ownsResource();
    }

    // ---------------------------------------------------------------------
    // sesiones: generadas al crear el curso; la asistencia vive en el mapa
    // `asistencias` ({estudianteId: 'presente' | 'tarde' | 'falta'}).
    // ---------------------------------------------------------------------
    match /sesiones/{sesionId} {
      allow read: if isActiveTeacher() && ownsResource();

      // La app escribe primero las sesiones y al final el curso, así que el
      // curso puede no existir aún. Si ya existe, debe ser del docente.
      allow create: if isActiveTeacher()
                    && request.resource.data.docenteId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'docenteId', 'cursoId', 'numero', 'fecha', 'horaInicio', 'horaFin',
                         'asistencias', 'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.keys().hasOnly([
                         'docenteId', 'cursoId', 'numero', 'fecha', 'horaInicio', 'horaFin',
                         'asistencias', 'createdAt', 'updatedAt'
                       ])
                    && isShortString(request.resource.data.cursoId, 1, 128)
                    && request.resource.data.numero is int
                    && request.resource.data.numero >= 1
                    && request.resource.data.numero <= 60
                    && request.resource.data.fecha is timestamp
                    && isHora(request.resource.data.horaInicio)
                    && isHora(request.resource.data.horaFin)
                    && request.resource.data.horaInicio < request.resource.data.horaFin
                    && request.resource.data.asistencias is map
                    && request.resource.data.asistencias.size() == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && (!exists(/databases/$(database)/documents/cursos/$(request.resource.data.cursoId))
                        || get(/databases/$(database)/documents/cursos/$(request.resource.data.cursoId)).data.docenteId == request.auth.uid);

      // Tomar asistencia o mover la fecha, solo en sesiones de un curso
      // propio y cercanas a hoy. Dueño, curso, número y horario quedan fijos.
      allow update: if isActiveTeacher()
                    && ownsResource()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['asistencias', 'fecha', 'updatedAt'])
                    && request.resource.data.asistencias is map
                    && request.resource.data.asistencias.size() <= 500
                    && request.resource.data.asistencias.values()
                         .hasOnly(['presente', 'tarde', 'falta'])
                    && isNearNow(resource.data.fecha)
                    && isNearNow(request.resource.data.fecha)
                    && request.resource.data.fecha > resource.data.fecha - duration.value(7, 'd')
                    && request.resource.data.fecha < resource.data.fecha + duration.value(7, 'd')
                    && request.resource.data.updatedAt == request.time
                    && isOwnCurso(resource.data.cursoId);

      allow delete: if isActiveTeacher() && ownsResource();
    }

    // ---------------------------------------------------------------------
    // estudiantes: registro del docente; se matriculan en `matriculas`.
    // ---------------------------------------------------------------------
    function isEstudianteValido(d) {
      return isShortString(d.codigo, 1, 20)
          && isShortString(d.nombres, 1, 80)
          && isShortString(d.apellidos, 1, 80)
          && (d.get('correo', null) == null || isShortString(d.correo, 3, 120));
    }

    match /estudiantes/{estudianteId} {
      allow read: if isActiveTeacher() && ownsResource();

      allow create: if isActiveTeacher()
                    && request.resource.data.docenteId == request.auth.uid
                    && request.resource.data.keys().hasAll([
                         'docenteId', 'codigo', 'nombres', 'apellidos', 'createdAt'
                       ])
                    && request.resource.data.keys().hasOnly([
                         'docenteId', 'codigo', 'nombres', 'apellidos', 'correo', 'createdAt'
                       ])
                    && isEstudianteValido(request.resource.data)
                    && request.resource.data.createdAt == request.time;

      allow update: if isActiveTeacher()
                    && ownsResource()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['codigo', 'nombres', 'apellidos', 'correo', 'updatedAt'])
                    && isEstudianteValido(request.resource.data)
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isActiveTeacher() && ownsResource();
    }

    // ---------------------------------------------------------------------
    // matriculas: id `{cursoId}_{estudianteId}` (una por estudiante y
    // curso). Al retirarse no se borran: cambian a 'retirada'.
    // ---------------------------------------------------------------------
    match /matriculas/{matriculaId} {
      allow read: if isActiveTeacher() && ownsResource();

      allow create: if isActiveTeacher()
                    && request.resource.data.docenteId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'docenteId', 'cursoId', 'estudianteId', 'estado', 'fecha'
                       ])
                    && matriculaId == request.resource.data.cursoId + '_' + request.resource.data.estudianteId
                    && request.resource.data.estado == 'activa'
                    && request.resource.data.fecha == request.time
                    && isOwnCurso(request.resource.data.cursoId)
                    && isOwnEstudiante(request.resource.data.estudianteId);

      allow update: if isActiveTeacher()
                    && ownsResource()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['estado', 'updatedAt'])
                    && request.resource.data.estado in ['activa', 'retirada']
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isActiveTeacher() && ownsResource();
    }

    // ---------------------------------------------------------------------
    // evaluaciones: con su peso (%) y las notas en el mapa `notas`
    // ({estudianteId: nota de 0 a 20}).
    // ---------------------------------------------------------------------
    match /evaluaciones/{evaluacionId} {
      allow read: if isActiveTeacher() && ownsResource();

      allow create: if isActiveTeacher()
                    && request.resource.data.docenteId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'docenteId', 'cursoId', 'nombre', 'tipo', 'peso', 'fecha', 'notas',
                         'createdAt', 'updatedAt'
                       ])
                    && isShortString(request.resource.data.nombre, 1, 60)
                    && request.resource.data.tipo in
                         ['practica', 'examen', 'trabajo', 'proyecto', 'participacion']
                    && request.resource.data.peso is int
                    && request.resource.data.peso >= 1
                    && request.resource.data.peso <= 100
                    && request.resource.data.fecha is timestamp
                    && request.resource.data.notas is map
                    && request.resource.data.notas.size() == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && isOwnCurso(request.resource.data.cursoId);

      // Registrar notas: solo cambia el mapa de notas.
      allow update: if isActiveTeacher()
                    && ownsResource()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['notas', 'updatedAt'])
                    && request.resource.data.notas is map
                    && request.resource.data.notas.size() <= 500
                    && request.resource.data.updatedAt == request.time;

      allow delete: if isActiveTeacher() && ownsResource();
    }

    // ---------------------------------------------------------------------
    // jornadas: una por sesión de curso, id `{uid}_{sesionId}`.
    // ---------------------------------------------------------------------

    // La sesión y el curso existen y son del docente; los datos copiados
    // coinciden con los reales y la entrada se marca cerca del día.
    function isJornadaValida(d) {
      let sesion = get(/databases/$(database)/documents/sesiones/$(d.sesionId)).data;
      let curso = get(/databases/$(database)/documents/cursos/$(d.cursoId)).data;
      return sesion.docenteId == request.auth.uid
          && sesion.cursoId == d.cursoId
          && curso.docenteId == request.auth.uid
          && curso.nombre == d.cursoNombre
          && sesion.numero == d.sesionNumero
          && sesion.horaInicio == d.horaProgramadaInicio
          && sesion.horaFin == d.horaProgramadaFin
          && request.time > sesion.fecha - duration.value(1, 'd')
          && request.time < sesion.fecha + duration.value(2, 'd');
    }

    match /jornadas/{jornadaId} {
      // Todas llevan el uid como prefijo del id, así se puede consultar una
      // que aún no existe.
      allow get: if isActiveTeacher()
                 && jornadaId.matches('^' + request.auth.uid + '_.+$');
      allow list: if isActiveTeacher()
                  && resource.data.docenteId == request.auth.uid;

      // Marcar entrada con la hora del servidor.
      allow create: if isActiveTeacher()
                    && request.resource.data.keys().hasAll([
                         'docenteId', 'cursoId', 'sesionId', 'cursoNombre', 'sesionNumero', 'fecha',
                         'horaProgramadaInicio', 'horaProgramadaFin', 'entrada', 'salida',
                         'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.keys().hasOnly([
                         'docenteId', 'cursoId', 'sesionId', 'cursoNombre', 'sesionNumero', 'fecha',
                         'horaProgramadaInicio', 'horaProgramadaFin', 'entrada', 'salida',
                         'createdAt', 'updatedAt'
                       ])
                    && request.resource.data.docenteId == request.auth.uid
                    && isShortString(request.resource.data.sesionId, 1, 128)
                    && isShortString(request.resource.data.cursoId, 1, 128)
                    && jornadaId == request.auth.uid + '_' + request.resource.data.sesionId
                    && isShortString(request.resource.data.cursoNombre, 1, 80)
                    && request.resource.data.sesionNumero is int
                    && request.resource.data.fecha is timestamp
                    && isHora(request.resource.data.horaProgramadaInicio)
                    && isHora(request.resource.data.horaProgramadaFin)
                    && request.resource.data.entrada == request.time
                    && request.resource.data.salida == null
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time
                    && isJornadaValida(request.resource.data);

      // Marcar salida: una sola vez, con la hora del servidor.
      allow update: if isActiveTeacher()
                    && resource.data.docenteId == request.auth.uid
                    && resource.data.salida == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['salida', 'updatedAt'])
                    && request.resource.data.salida == request.time
                    && request.resource.data.updatedAt == request.time;

      // El historial nunca se borra.
      allow delete: if false;
    }
  }
}
